act/blob/711c445bccc331b3ef85a793feb8e13dcf968fc3/packages%2Freact-client%2Fsrc%2FReactFlightClient.js","changes":15,"contents_url":"https://api.github.com/repos/react/react/contents/packages%2Freact-client%2Fsrc%2FReactFlightClient.js?ref=711c445bccc331b3ef85a793feb8e13dcf968fc3","deletions":1,"filename":"packages/react-client/src/ReactFlightClient.js","patch":"@@ -4031,11 +4031,24 @@ const createFakeJSXCallStackInDEV: (\n     ) as any)\n   : (null as any);\n \n+// v8 (Chromium, Node.js) defaults to 10\n+// SpiderMonkey (Firefox) does not support Error.stackTraceLimit\n+// JSC (Safari) defaults to 100\n+// The lower the limit, the more likely we'll not reach react_stack_bottom_frame\n+// The higher the limit, the slower Error() is when not inspecting with a debugger.\n+// When inspecting with a debugger, Error.stackTraceLimit has no impact on Error() performance (in v8).\n+const ownerStackTraceLimit = 10;\n+\n /** @noinline */\n function fakeJSXCallSite() {\n   // This extra call frame represents the JSX creation function. We always pop this frame\n   // off before presenting so it needs to be part of the stack.\n-  return new Error('react-stack-top-frame');\n+  let error;\n+  const previousStackTraceLimit = Error.stackTraceLimit;\n+  Error.stackTraceLimit = ownerStackTraceLimit;\n+  error = Error('react-stack-top-frame'); // eslint-disable-line prefer-const\n+  Error.stackTraceLimit = previousStackTraceLimit;\n+  return error;\n }\n \n function initializeFakeStack(","raw_url":"https://github.com/react/react/raw/711c445bccc331b3ef85a793feb8e13dcf968fc3/packages%2Freact-client%2Fsrc%2FReactFlightClient.js","sha":"348132c7f2534d9fcadf5bcf2f19aadef1478e18","status":"modified"},{"additions":19,"blob_url":"https://github.com/react/react/blob/711c445bccc331b3ef85a793feb8e13dcf968fc3/packages%2Freact-client%2Fsrc%2F__tests__%2FReactFlight-test.js","changes":19,"contents_url":"https://api.github.com/repos/react/react/contents/packages%2Freact-client%2Fsrc%2F__tests__%2FReactFlight-test.js?ref=711c445bccc331b3ef85a793feb8e13dcf968fc3","deletions":0,"filename":"packages/react-client/src/__tests__/ReactFlight-test.js","patch":"@@ -3915,6 +3915,25 @@ describe('ReactFlight', () => {\n     expect(ReactNoop).toMatchRenderedOutput(<span>Hello, Seb</span>);\n   });\n \n+  it('restores the stack trace limit after recreating JSX call sites', async () => {\n+    function Component() {\n+      return ReactServer.createElement('div');\n+    }\n+\n+    const transport = ReactNoopFlightServer.render(\n+      ReactServer.createElement(Component),\n+    );\n+    const previousStackTraceLimit = Error.stackTraceLimit;\n+    Error.stackTraceLimit = 50;\n+    try {\n+      await ReactNoopFlightClient.read(transport);\n+\n+      expect(Error.stackTraceLimit).toBe(50);\n+    } finally {\n+      Error.stackTraceLimit = previousStackTraceLimit;\n+    }\n+  });\n+\n   // @gate __DEV__\n   it('can get the component owner stacks during rendering in dev', () => {\n     let stack;","raw_url":"https://github.com/react/react/raw/711c445bccc331b3ef85a793feb8e13dcf968fc3/packages%2Freact-client%2Fsrc%2F__tests__%2FReactFlight-test.js","sha":"5bb9efea932b32bb331fb10e8ba5aa540e2af513","status":"modified"}],"html_url":"https://github.com/react/react/commit/711c445bccc331b3ef85a793feb8e13dcf968fc3","node_id":"C_kwDOAJy2KtoAKDcxMWM0NDViY2NjMzMxYjNlZjg1YTc5M2ZlYjhlMTNkY2Y5NjhmYzM","parents":[{"html_url":"https://github.com/react/react/commit/81e442eaf3fbfabd2367a0d8691ec0df13a3add0","sha":"81e442eaf3fbfabd2367a0d8691ec0df13a3add0","url":"https://api.github.com/repos/react/react/commits/81e442eaf3fbfabd2367a0d8691ec0df13a3add0"}],"sha":"711c445bccc331b3ef85a793feb8e13dcf968fc3","stats":{"additions":33,"deletions":1,"total":34},"url":"https://api.github.com/repos/react/react/commits/711c445bccc331b3ef85a793feb8e13dcf968fc3"},"repository_id":"react/react","request":{"command":["gh","api","repos/react/react/commits/711c445bccc331b3ef85a793feb8e13dcf968fc3"],"operation":"read_co