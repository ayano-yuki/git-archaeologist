      [\n+        '​App',\n+        {\n+          detail: {\n+            devtools: {\n+              color: 'primary-dark',\n+              properties: [\n+                ['Changed Props', ''],\n+                ['-\\xa0buffer', 'Uint8Array(0)'],\n+                ['+\\xa0buffer', 'Float32Array(1000)'],\n               ],\n               tooltipText: 'App',\n               track: 'Components ⚛',","raw_url":"https://github.com/react/react/raw/e71a6393e66b0d2add46ba2b2c5db563a0563828/packages%2Freact-reconciler%2Fsrc%2F__tests__%2FReactPerformanceTrack-test.js","sha":"cdc4f40f4a2b8153571befea94c7bd4d8e15cd6f","status":"modified"},{"additions":20,"blob_url":"https://github.com/react/react/blob/e71a6393e66b0d2add46ba2b2c5db563a0563828/packages%2Fshared%2FReactPerformanceTrackProperties.js","changes":20,"contents_url":"https://api.github.com/repos/react/react/contents/packages%2Fshared%2FReactPerformanceTrackProperties.js?ref=e71a6393e66b0d2add46ba2b2c5db563a0563828","deletions":0,"filename":"packages/shared/ReactPerformanceTrackProperties.js","patch":"@@ -61,6 +61,14 @@ export function addObjectToProperties(\n   indent: number,\n   prefix: string,\n ): void {\n+  if (ArrayBuffer.isView(object)) {\n+    // Typed arrays (e.g. Uint8Array, Float32Array) can hold millions of\n+    // elements. Enumerating them with for...in forces the engine to\n+    // materialize a key for every index, which can freeze the page. Their\n+    // contents aren't useful to show here so we skip them. DataView has no\n+    // enumerable properties to show anyway.\n+    return;\n+  }\n   let addedProperties = 0;\n   for (const key in object) {\n     if (hasOwnProperty.call(object, key) && key[0] !== '_') {\n@@ -165,6 +173,18 @@ export function addValueToProperties(\n         // $FlowFixMe[method-unbinding]\n         const objectToString = Object.prototype.toString.call(value);\n         let objectName = objectToString.slice(8, objectToString.length - 1);\n+        if (ArrayBuffer.isView(value)) {\n+          // Typed arrays can hold millions of elements. Showing the type and\n+          // length is more useful than enumerating every index (which is also\n+          // prohibitively slow, see addObjectToProperties). DataView is the\n+          // only view without a length; show just its type.\n+          const length = (value as any).length;\n+          desc =\n+            typeof length === 'number'\n+              ? objectName + '(' + length + ')'\n+              : objectName;\n+          break;\n+        }\n         if (objectName === 'Array') {\n           const array: Array<any> = value as any;\n           const didTruncate = array.length > OBJECT_WIDTH_LIMIT;","raw_url":"https://github.com/react/react/raw/e71a6393e66b0d2add46ba2b2c5db563a0563828/packages%2Fshared%2FReactPerformanceTrackProperties.js","sha":"16c817dd8e444a535ed95ef5563ad5dbab153176","status":"modified"}],"html_url":"https://github.com/react/react/commit/e71a6393e66b0d2add46ba2b2c5db563a0563828","node_id":"C_kwDOAJy2KtoAKGU3MWE2MzkzZTY2YjBkMmFkZDQ2YmEyYjJjNWRiNTYzYTA1NjM4Mjg","parents":[{"html_url":"https://github.com/react/react/commit/3508aee63d59b7d4eb8e82171b78ef214a2487ca","sha":"3508aee63d59b7d4eb8e82171b78ef214a2487ca","url":"https://api.github.com/repos/react/react/commits/3508aee63d59b7d4eb8e82171b78ef214a2487ca"}],"sha":"e71a6393e66b0d2add46ba2b2c5db563a0563828","stats":{"additions":83,"deletions":105,"total":188},"url":"https://api.github.com/repos/react/react/commits/e71a6393e66b0d2add46ba2b2c5db563a0563828"},"repository_id":"react/react","request":{"command":["gh","api","repos/react/react/commits/e71a6393e66b0d2add46ba2b2c5db563a0563828"],"operation":"read_commit_detail","target":"e71a6393e66b0d2add46ba2b2c5db563a0563828"},"schema_version":1,"source_url":"https://github.com/react/react/commit/e71a6393e66b0d2add46ba2b2c5db563a0563828"}